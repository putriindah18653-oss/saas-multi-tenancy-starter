# Backend-API environment variables — copy to backend-api/.env before running.
# See config/config.go for defaults and validation.

# Application
APP_ENV=development # development | production — production enforces HTTPS cookies & JWT strength
APP_PORT=8080
TRUST_PROXY=false # set true when behind a trusted reverse proxy (nginx, Cloudflare)

# Database (PostgreSQL via pgx pool)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_starter?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_TIMEOUT=3s

# Redis (go-redis v9)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_HEALTH_TIMEOUT=3s

# JWT — HS256 secrets. Minimum 32 characters in production.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# CORS — comma-separated allowed origins. Wildcard (*) only allowed in development.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Internal proxy (Cloudflare Dashboard Worker) — shared secret for X-Internal-Tenant-ID verification.
# Must match the value in workers/dashboard/wrangler.toml.
# When empty, the server accepts X-Internal-Tenant-ID from any caller (insecure outside dev).
INTERNAL_PROXY_SECRET=
