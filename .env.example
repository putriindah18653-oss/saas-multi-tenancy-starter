# Application
APP_ENV=development
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=saas_starter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/saas_starter?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# JWT - replace before any shared or production deployment
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# CORS / frontend
# Use * only for local/LAN development. In production, set explicit origins.
CORS_ALLOWED_ORIGINS=*
# Optional. Leave empty in local/LAN development so frontend uses current host + :8080.
VITE_API_BASE_URL=
VITE_TENANT_HEADER=X-Tenant-ID

# Optional production image tags
BACKEND_IMAGE=saas-starter-backend:latest
FRONTEND_IMAGE=saas-starter-frontend:latest

# Production ports; override if a reverse proxy owns 80/443
PROD_BACKEND_PORT=8080
PROD_FRONTEND_PORT=80
