# Application
APP_ENV=development
APP_PORT=8080
# Host port used only for local backend access from the host. Inside Docker, backend still listens on 8080.
BACKEND_PORT=18080

# PostgreSQL
POSTGRES_DB=saas_starter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port used only for local tools from the host. Inside Docker, services still use postgres:5432.
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@postgres:5432/saas_starter?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
# Host port used only for local tools from the host. Inside Docker, services still use redis:6379.
REDIS_PORT=6380

# JWT - replace before any shared or production deployment
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# CORS / frontend
# Use * only for local/LAN development. In production, set explicit origins.
CORS_ALLOWED_ORIGINS=*
# Optional. Leave empty in local/LAN development so frontend uses current host + :8080.
VITE_API_BASE_URL=
VITE_TENANT_HEADER=X-Tenant-ID

# Optional production image tags
BACKEND_IMAGE=saas-starter-backend:latest
FRONTEND_IMAGE=saas-starter-frontend:latest

# Production ports; override if a reverse proxy owns 80/443
PROD_BACKEND_PORT=8080
PROD_FRONTEND_PORT=80

# Cloudflare Workers (see workers/dashboard/wrangler.toml)
# Set TRUST_PROXY=true to trust X-Real-IP and CF-Connecting-IP from Workers.
TRUST_PROXY=false
# Internal shared secret that the Dashboard Worker sends to prove it is the edge proxy.
# Must match the value in wrangler.toml vars.INTERNAL_PROXY_SECRET.
INTERNAL_PROXY_SECRET=
